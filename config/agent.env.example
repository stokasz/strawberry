# Mounted into the agent container. Host URL/key are synced by `strawberry onboard`.
STRAWBERRY_AGENT_BIND_HOST=0.0.0.0
STRAWBERRY_AGENT_PORT=4501
STRAWBERRY_AGENT_API_KEY=
STRAWBERRY_AGENT_DIR=/opt/strawberry/.strawberry
STRAWBERRY_AGENT_STATE_ROOT=/opt/strawberry/state/agent
STRAWBERRY_HOST_BASE_URL=http://192.168.64.1:4510
STRAWBERRY_HOST_API_KEY=
