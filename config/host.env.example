# Host-only secrets and generated runtime wiring (updated by `strawberry onboard`).
STRAWBERRY_HOST_BIND_HOST=0.0.0.0
STRAWBERRY_HOST_PORT=4510
STRAWBERRY_HOST_STATE_ROOT=.strawberry/state/host
# Optional until you use chain reads.
STRAWBERRY_RPC_URL=
STRAWBERRY_SIGNER_COMMAND=
# Generated by `strawberry onboard`; lets trusted host handlers fetch guest uploads.
STRAWBERRY_AGENT_API_KEY=
