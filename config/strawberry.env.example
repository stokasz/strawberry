STRAWBERRY_INSTALL_ROOT=/opt/strawberry
STRAWBERRY_WORKSPACE_ROOT=/Users/you/.strawberry/workspace
STRAWBERRY_CONTAINER_IMAGE=strawberry-agent:local
STRAWBERRY_CONTAINER_NAME=strawberry-agent
STRAWBERRY_CONTAINER_STATE_ROOT=/Users/you/.strawberry/workspace/state/container
STRAWBERRY_CONTAINER_HOST_GATEWAY=192.168.64.1
STRAWBERRY_CONTAINER_CPUS=2
STRAWBERRY_CONTAINER_MEMORY=2g
STRAWBERRY_LOG_ROOT=/Users/you/.strawberry/workspace/logs
STRAWBERRY_AGENT_PORT=4501
STRAWBERRY_HOST_PORT=4510
