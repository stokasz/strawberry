# Telegram reaches the agent over localhost. Keys are generated by `strawberry onboard`.
STRAWBERRY_AGENT_BASE_URL=http://127.0.0.1:4501
STRAWBERRY_AGENT_API_KEY=
STRAWBERRY_TELEGRAM_BOT_TOKEN=
STRAWBERRY_TELEGRAM_BOT_USERNAME=
# Optional override. Normally pair by sending /pair with the local pairing code.
STRAWBERRY_TELEGRAM_GROUP_CHAT_ID=
# Local one-time group pairing code generated by `strawberry onboard`.
STRAWBERRY_TELEGRAM_PAIRING_CODE=
# Optional. Only needed for private admin DMs; group chat does not need your user ID.
STRAWBERRY_TELEGRAM_ADMIN_USER_ID=
STRAWBERRY_TELEGRAM_ALLOW_PUBLIC_GROUPS=0
STRAWBERRY_TELEGRAM_ALLOW_PUBLIC_DMS=0
STRAWBERRY_TELEGRAM_STATE_ROOT=.strawberry/state/telegram
STRAWBERRY_TELEGRAM_GROUP_CONTEXT_MAX_MESSAGES=40
STRAWBERRY_TELEGRAM_GROUP_CONTEXT_MAX_CHARS=6000
